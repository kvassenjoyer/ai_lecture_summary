# Fully local profile. GPU is selected automatically when CUDA is available.
DATABASE_URL=sqlite:///./data/lectures.db
STORAGE_BACKEND=local
DATA_DIR=data
HF_HOME=models
MODEL_DEVICE=auto
MODEL_LOCAL_FILES_ONLY=true
WHISPER_MODEL=openai/whisper-large-v3-turbo
QWEN_MODEL=Qwen/Qwen3.5-4B
QWEN_LOAD_IN_4BIT=true
FFMPEG_PATH=ffmpeg
MAX_UPLOAD_MB=500
MAX_AUDIO_SECONDS=14400
CHUNK_SECONDS=30
CHUNK_OVERLAP_SECONDS=4
SUMMARY_CHUNK_TOKENS=1800
SUMMARY_MAX_NEW_TOKENS=900
POLL_INTERVAL_SECONDS=1
# For host Python + Docker infrastructure (compose ports 5433/9000):
# DATABASE_URL=postgresql+psycopg://lecture:lecture_local@127.0.0.1:5433/lectures
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=lectures
# S3_ACCESS_KEY_ID=lecture_minio
# S3_SECRET_ACCESS_KEY=lecture_minio_local_secret
# S3_REGION=us-east-1
